{
  "name": "@maxonfjvipon/xslint",
  "version": "0.0.0",
  "description": "XSL Linter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xslint/xslint.git"
  },
  "homepage": "https://github.com/xslint/xslint#readme",
  "bugs": "https://github.com/xslint/xslint/issues",
  "main": "src/xslint.js",
  "bin": {
    "xslint": "src/index.mjs"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "patch-package",
    "test": "grunt",
    "fast": "grunt fast",
    "coverage": "c8 mocha \"test/**/*.test.js\" --timeout 10000 --parallel"
  },
  "keywords": [
    "xsl",
    "linter"
  ],
  "author": "maxonfjvipon",
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.9",
    "colors": "1.4.0",
    "commander": "^15.0.0",
    "fontoxpath": "^3.34.0",
    "minimatch": "^10.2.5",
    "patch-package": "^8.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/mocha-runner": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "c8": "^12.0.0",
    "eslint": "^10.5.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^64.0.1",
    "globals": "^17.6.0",
    "grunt": "^1.6.1",
    "grunt-cli": "^1.5.0",
    "grunt-eslint": "^27.0.0",
    "grunt-mocha-cli": "^7.0.0",
    "marked": "^18.0.7",
    "mocha": "^11.0.1"
  },
  "overrides": {
    "diff": "^9.0.0",
    "grunt": {
      "js-yaml": "^4.3.1"
    },
    "grunt-eslint": {
      "eslint": "$eslint"
    },
    "grunt-mocha-cli": {
      "mocha": "$mocha"
    },
    "serialize-javascript": "^7.1.0",
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  }
}
